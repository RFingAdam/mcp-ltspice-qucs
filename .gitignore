# Private design experiments. These stay local for review and don't
# get pushed. Add a gitkeep'd subfolder under examples/ to share an
# example you want public.
examples/halow_lpf/
examples/halow_lpf.zip
examples/private/
examples/_local/
examples/_archive/
# Generated bundle PDFs: re-buildable from each example's design.py
examples/**/report.pdf

# pre-commit
.pre-commit-cache/

# Workflow scratch files (private to the maintainer)
tasks/

# Pitch/business material kept private
/presentation/

# Simulator scratch dropped in the repo root by ad-hoc runs (.s2p/.asc/.cir/
# .net/.raw/.log/.png). Anchored with a leading slash so the committed example
# Touchstones under examples/ are never caught by this -- downstream consumers
# read those, so ignoring them would be worse than the mess.
/*.s2p
/*.asc
/*.cir
/*.net
/*.raw
/*.log
/*.png
/workspace/
/outputs/
/example/
